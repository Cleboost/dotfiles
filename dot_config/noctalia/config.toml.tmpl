# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                                                              │
# │                          ⚡ NOCTALIA CONFIGURATION ⚡                         │
# │                                                                              │
# └──────────────────────────────────────────────────────────────────────────────┘

{{- $output := "DP-2" -}}
{{- if eq .chezmoi.hostname "cleboost-sage" -}}
  {{- $output = "eDP-1" -}}
{{- end -}}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  1. SHELL & BEHAVIOR                                                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[shell]
ui_scale                       = 1.0
font_family                    = "JetBrainsMono Nerd Font"
lang                           = "fr"                                  # Shell language (baguette btw)
avatar_path                    = "/home/cleboost/Pictures/profile.png" # My Avatar ;)
offline_mode                   = false                                 # block all outgoing HTTP when true
telemetry_enabled              = true                                  # send an anonymous usage ping on startup
polkit_agent                   = true
password_style                 = "random"                              # default | random
settings_show_advanced         = false                                 # show advanced settings by default in Settings
show_location                  = true                                  # hide weather location text in shell UI when false
screen_time_enabled            = true                                  # Password style in polkit agent
corner_radius_scale            = 2.0
clipboard_auto_paste           = "off"
clipboard_image_action_command = "feh {path}"                          # When we click on image in press-paper

[shell.animation]
enabled = true
speed   = 1.0                       # 0.5 = 2× slower, 2.0 = 2× faster

[shell.shadow]
blur     = 12                       # global surface shadow blur radius
offset_x = 2
offset_y = 2                        # positive = down
alpha    = 0.55                     # multiplied by each component's background opacity

[shell.mpris]
blacklist = []                      # ignore MPRIS players by bus/identity/desktop entry token

[shell.screen_corners]
enabled = true

[shell.greeter_sync]
auto_sync = true

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  2. WALLPAPER & THEME                                                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[wallpaper]
enabled             = true
fill_mode           = "crop"        # center | crop | fit | stretch | repeat
fill_color          = ""            # optional fallback/fill color: #RRGGBB, #RRGGBBAA, or theme role
transition          = ["disc", "stripes", "zoom"]
transition_duration = 1500          # milliseconds
edge_smoothness     = 0.3
directory           = "~/Pictures/Wallpapers"
directory_light     = ""            # optional day-mode directory
directory_dark      = ""            # optional night-mode directory

[wallpaper.automation]
enabled          = false
interval_minutes = 0                # 0 = disabled
order            = "random"           # random | alphabetical
recursive        = true             # include subdirectories when picking random wallpapers

[theme]
mode              = "dark"          # dark | light | auto
source            = "wallpaper"     # builtin | wallpaper | community
builtin           = "Ayu"           # Ayu | Catppuccin | Dracula | Eldritch | Gruvbox | Kanagawa | Noctalia | Nord | Rosé Pine | Tokyo-Night
community_palette = "ADW"           # fetched from api.noctalia.dev, cached locally
wallpaper_scheme  = "m3-content"    # m3-tonal-spot | m3-content | m3-fruit-salad | m3-rainbow | m3-monochrome | vibrant | faithful | dysfunctional | muted

[theme.templates]
enable_builtins       = true
builtin_ids           = ["btop", "gtk3", "gtk4", "hyprland", "kitty", "qt", "starship"] # opt-in; list ids with: noctalia theme --list-builtins
community_ids         = []
enable_user_templates = false
user_config           = "~/.config/noctalia/user-templates.toml"

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  3. SYSTEM MONITOR & SERVICES                                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[system.monitor]
enabled = true                      # sample CPU, memory, network, load, temperature, and disk statistics

[weather]
enabled         = true
auto_locate     = true              # resolve location from IP when true
address         = "Toronto, ON"     # geocoded when auto_locate = false
refresh_minutes = 30
unit            = "celsius"         # celsius | fahrenheit

[audio]
enable_overdrive    = false         # allow volume above 100% (up to 150%)
enable_sounds       = true          # master toggle for UI feedback sounds
sound_volume        = 0.5           # 0.0 - 1.0
volume_change_sound = ""            # empty = bundled sounds/volume-change.wav
notification_sound  = ""            # empty = bundled sounds/notification.wav

[brightness]
enable_ddcutil = false

[nightlight]
enabled              = false
force                = false
use_weather_location = true
temperature_day      = 6500         # Kelvin
temperature_night    = 4000         # Kelvin

[idle.behavior.lock]
enabled = false
timeout = 660
command = "noctalia:lock"

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  4. OVERVIEW, NOTIFICATIONS & INPUT                                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[overview]
enabled                = false
unload_when_not_in_use = true
blur_intensity         = 0.5        # 0.0 = no blur, 1.0 = maximum
tint_intensity         = 0.3        # 0.0 = no tint, 1.0 = opaque

[notification]
enable_daemon      = true
background_opacity = 0.97

[osd]
position = "top_right"              # top_right | top_left | top_center | bottom_right | bottom_left | bottom_center

[keybinds]
validate = ["return", "kp_enter"]
cancel   = ["escape"]
left     = ["left"]
right    = ["right"]
up       = ["up"]
down     = ["down"]

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  5. STATUS BAR                                                               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

#[bar]
#order = [ "main" ]

[bar.main]
position           = "top"          # top | bottom | left | right
thickness          = 34
background_opacity = 0.85
radius             = 80
radius_top_left    = 0
radius_top_right   = 0
margin_h           = 180
margin_v           = 10
margin_edge        = 0
margin_ends        = 230
padding            = 14
widget_spacing     = 6
scale              = 1.0
shadow             = true
auto_hide          = false
reserve_space      = true
capsule            = false

start  = ["cpu", "temp", "ram", "workspaces"]
center = ["media", "audio_visualizer"]
end    = [
    "cat",
    "recorder",
    "notifications",
    "tray",
    "screen_recorder",
    "clock",
    "control-center"
    {{- if eq .chezmoi.hostname "cleboost-brain" -}},
    "widget"
    {{- end }}
]

# ── Bar Widgets ───────────────────────────────────────────────────────────────

[widget.audio_visualizer]
capsule        = true
show_when_idle = true

[widget.cat]
type          = "noctalia/bongocat:cat"
input_devices = ["/dev/input/by-path/platform-i8042-serio-0-event-kbd"]

[widget.cpu]
type       = "sysmon"
display    = "gauge"
show_label = false

[widget.sysmon]
stat = "cpu_usage"

[widget.media]
capsule      = true
title_scroll = "always"

[widget.ram]
show_label = false

[widget.recorder]
type = "noctalia/screen_recorder:recorder"

[widget.screen_recorder]
type              = "scripted"
script            = "scripts/screen_recorder.lua"
directory         = "Videos"
filename_pattern  = "recording_%Y%m%d_%H%M%S"
video_codec       = "av1"
audio_codec       = "opus"
audio_source      = "both"
quality           = "ultra"
frame_rate        = 144
color_range       = "limited"
resolution        = "original"
show_cursor       = true
copy_to_clipboard = false
restore_portal    = true
replay_enabled    = false
replay_duration   = 30
replay_storage    = "ram"
hide_inactive     = false

[widget.temp]
show_label = false

[widget.tray]
capsule = true
drawer  = true
hidden  = ["spotify", "discord"]
pinned  = ["MP-wLD5ZvD"]

[widget.workspaces]
capsule = true
display = "name"

{{- if eq .chezmoi.hostname "cleboost-brain" }}
[widget.widget]
type = "noctalia/mechsound:widget"
{{- end }}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  6. APPLICATION DOCK                                                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[dock]
enabled             = false         # set true to activate
position            = "bottom"      # top | bottom | left | right
icon_size           = 48
padding             = 8
item_spacing        = 6
background_opacity  = 0.88
radius              = 16
margin_h            = 0
margin_v            = 8
shadow              = true
show_running        = true
auto_hide           = false
reserve_space       = false
active_scale        = 1.0
inactive_scale      = 0.85
active_opacity      = 1.0
inactive_opacity    = 0.85
show_instance_count = true
active_monitor_only = false
pinned              = []            # e.g. ["firefox", "code", "kitty"]

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  7. DESKTOP WIDGETS                                                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[desktop_widgets]
enabled        = true
schema_version = 1
widget_order   = [
    "desktop_clock",
    "desktop_audio_visualizer",
    "desktop_media_player",
    "desktop_weather"
]

[desktop_widgets.grid]
cell_size      = 16
major_interval = 4
visible        = true

[desktop_widgets.widget.desktop_clock]
type       = "clock"
box_height = 341.0
box_width  = 579.0
cx         = 961.5
cy         = 406.5
output     = "{{ $output }}"
rotation   = 0.0

[desktop_widgets.widget.desktop_clock.settings]
background = false

[desktop_widgets.widget.desktop_audio_visualizer]
type       = "audio_visualizer"
box_height = 0.0
box_width  = 0.0
cx         = 968.0
cy         = 556.0
output     = "{{ $output }}"
rotation   = 0.0

[desktop_widgets.widget.desktop_audio_visualizer.settings]
aspect_ratio   = 2.5
background     = false
bands          = 32
show_when_idle = true

[desktop_widgets.widget.desktop_media_player]
type       = "media_player"
box_height = 117.25372314453125
box_width  = 274.19699096679688
cx         = 160.0
cy         = 998.6268310546875
output     = "{{ $output }}"
rotation   = 0.0

[desktop_widgets.widget.desktop_media_player.settings]
layout = "horizontal"

[desktop_widgets.widget.desktop_weather]
type       = "weather"
box_height = 0.0
box_width  = 0.0
cx         = 118.0
cy         = 892.0
output     = "{{ $output }}"
rotation   = 0.0

[desktop_widgets.widget.desktop_weather.settings]
background = false

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  8. CONTROL CENTER & HOOKS                                                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[[control_center.shortcuts]]
type = "wifi"

[[control_center.shortcuts]]
type = "bluetooth"

[[control_center.shortcuts]]
type = "notification"

[[control_center.shortcuts]]
type = "power_profile"

[hooks]
battery_low_percent_threshold = 30
power_profile_changed         = "~/.local/bin/asus-perf-keyboard-color"

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  9. PLUGINS & EXTENSIONS                                                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

[plugins]
enabled = [
    "noctalia/bongocat",
    "noctalia/screen_recorder",
    "noctalia/translator",
    "cleboost/anilist",
    "cleboost/ssh-launcher"
    {{- if eq .chezmoi.hostname "cleboost-brain" -}},
    "cleboost/bitwarden",
    "radimous/prismlauncher-instances",
    "cleboost/zed-provider",
    "cleboost/jetbrains-provider"
    {{- end }}
]

[[plugins.source]]
name        = "official"
kind        = "git"
location    = "https://github.com/noctalia-dev/official-plugins"
auto_update = true

[[plugins.source]]
name        = "community"
kind        = "git"
location    = "https://github.com/noctalia-dev/community-plugins"
auto_update = true

{{- if eq .chezmoi.hostname "cleboost-brain" }}
[[plugins.source]]
name     = "community-local"
kind     = "path"
location = "/home/cleboost/Projects/noctalia/community-plugins"
{{- end }}

[plugin_settings."noctalia/screen_recorder"]
frame_rate   = 144
quality      = "ultra"
video_codec  = "h264"
video_source = "portal"
