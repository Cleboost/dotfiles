#!/usr/bin/env bash
# Stylized update script with smooth animated spinner for Cleboost NixOS
CYAN="\033[1;36m"
GREEN="\033[1;32m"
RED="\033[1;31m"
RESET="\033[0m"
DIM="\033[2m"

echo -e "${CYAN} Updating flake inputs and rebuilding NixOS...${RESET}"

# Temp file for capturing filtered log output
TMP_LOG=$(mktemp /tmp/nixos-update-XXXXXX.log)

# Run nh in background so we can display a live glowing spinner while it updates/builds
nh os switch -u /home/cleboost/dotfiles 2>&1 \
  | grep -v -E '(Checking switch inhibitors|Skipping "/boot|activating the configuration|setting up /etc|reloading user units|restarting user units|restarting sysinit|the following new units)' \
  > "$TMP_LOG" &

NH_PID=$!

# Braille spinner frames
SPINNER_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
START_TIME=$(date +%s)

# Hide cursor
tput civis 2>/dev/null || true

while kill -0 "$NH_PID" 2>/dev/null; do
  NOW=$(date +%s)
  ELAPSED=$((NOW - START_TIME))
  FRAME_IDX=$(( (NOW * 10 + $(date +%N | cut -c1-2 | sed 's/^0//')) / 10 % 10 ))
  FRAME=${SPINNER_FRAMES[$FRAME_IDX]:-⠋}
  
  # Check if sudo prompt appeared
  if grep -q "Mot de passe" "$TMP_LOG" 2>/dev/null; then
    break
  fi

  printf "\r${CYAN}${FRAME}${RESET} ${DIM}Updating inputs & building system...${RESET} ${CYAN}[${ELAPSED}s]${RESET}  "
  sleep 0.08
done

# Restore cursor
tput cnorm 2>/dev/null || true
printf "\r\033[K" # Clear spinner line

# Wait for process and display output
wait "$NH_PID"
exit_code=$?

# Print the clean output
cat "$TMP_LOG"
rm -f "$TMP_LOG"

if [ $exit_code -eq 0 ]; then
    fastfetch-update-cache 2>/dev/null || true
    echo -e "${GREEN}✔ System update completed successfully!${RESET}"
else
    echo -e "${RED}✖ Update failed with exit code $exit_code${RESET}"
    exit $exit_code
fi
