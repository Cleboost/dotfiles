#!/usr/bin/env bash
# Stylized rebuild script with smooth animated spinner for Cleboost NixOS
CYAN="\033[1;36m"
GREEN="\033[1;32m"
RED="\033[1;31m"
RESET="\033[0m"
DIM="\033[2m"

DOTFILES_DIR="/home/cleboost/dotfiles"
MODE="user"

# Parse arguments
for arg in "$@"; do
  case "$arg" in
    -s|--system)
      MODE="system"
      ;;
    -h|--help)
      echo -e "${CYAN}Usage:${RESET} rebuild [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  (no args)      Fast user / Home Manager rebuild (~3s, no sudo)"
      echo "  -s, --system   Full NixOS system rebuild (with sudo, bootloader, kernel, etc.)"
      echo "  -h, --help     Show this help message"
      exit 0
      ;;
  esac
done

# Braille spinner frames
SPINNER_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

run_spinner() {
  local pid=$1
  local msg=$2
  local log_file=$3
  local start_time=$(date +%s)
  
  tput civis 2>/dev/null || true

  while kill -0 "$pid" 2>/dev/null; do
    local now=$(date +%s)
    local elapsed=$((now - start_time))
    local frame_idx=$(( (now * 10 + $(date +%N | cut -c1-2 | sed 's/^0//')) / 10 % 10 ))
    local frame=${SPINNER_FRAMES[$frame_idx]:-⠋}

    if grep -q -E "(Mot de passe|Password|sudo)" "$log_file" 2>/dev/null; then
      break
    fi

    printf "\r${CYAN}${frame}${RESET} ${DIM}${msg}...${RESET} ${CYAN}[${elapsed}s]${RESET}  "
    sleep 0.08
  done

  tput cnorm 2>/dev/null || true
  printf "\r\033[K"
}

TMP_LOG=$(mktemp /tmp/rebuild-XXXXXX.log)

if [ "$MODE" = "system" ]; then
  echo -e "${CYAN} Rebuilding full NixOS system configuration...${RESET}"
  
  nh os switch "$DOTFILES_DIR" 2>&1 \
    | grep -v -E '(Checking switch inhibitors|Skipping "/boot|activating the configuration|setting up /etc|reloading user units|restarting user units|restarting sysinit|the following new units)' \
    > "$TMP_LOG" &
  
  CMD_PID=$!
  run_spinner "$CMD_PID" "Evaluating and building full system" "$TMP_LOG"
  wait "$CMD_PID"
  exit_code=$?
else
  echo -e "${CYAN}⚡ Rebuilding Home Manager configuration (fast mode)...${RESET}"
  
  (
    BUILD_ERR=$(mktemp /tmp/rebuild-build-err-XXXXXX.log)
    OUT_PATH=$(nix build "$DOTFILES_DIR#nixosConfigurations.cleboost-brain.config.home-manager.users.cleboost.home.activationPackage" --no-link --print-out-paths 2>"$BUILD_ERR")
    BUILD_STATUS=$?
    cat "$BUILD_ERR"
    rm -f "$BUILD_ERR"
    if [ $BUILD_STATUS -ne 0 ] || [ -z "$OUT_PATH" ]; then
      exit 1
    fi
    "$OUT_PATH/activate"
  ) > "$TMP_LOG" 2>&1 &
  
  CMD_PID=$!
  run_spinner "$CMD_PID" "Building and activating user environment" "$TMP_LOG"
  wait "$CMD_PID"
  exit_code=$?
fi

cat "$TMP_LOG"
rm -f "$TMP_LOG"

if [ $exit_code -eq 0 ]; then
  fastfetch-update-cache 2>/dev/null || true
  if [ "$MODE" = "system" ]; then
    echo -e "${GREEN}✔ System switch completed successfully!${RESET}"
  else
    echo -e "${GREEN}✔ User environment updated in seconds!${RESET}"
  fi
else
  echo -e "${RED}✖ Rebuild failed with exit code $exit_code${RESET}"
  exit $exit_code
fi
