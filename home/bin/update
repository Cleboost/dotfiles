#!/usr/bin/env bash
# Update flake inputs and switch system (nh)
CYAN="\033[1;36m"
GREEN="\033[1;32m"
RED="\033[1;31m"
RESET="\033[0m"
DIM="\033[2m"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/spinner.sh
source "$SCRIPT_DIR/lib/spinner.sh"

DOTFILES_DIR="/home/cleboost/dotfiles"

echo -e "${CYAN} Updating flake inputs and rebuilding NixOS...${RESET}"

TMP_LOG=$(mktemp /tmp/nixos-update-XXXXXX.log)

nh os switch -u "$DOTFILES_DIR" 2>&1 | nh_quiet_filter > "$TMP_LOG" &

CMD_PID=$!
run_spinner "$CMD_PID" "Updating inputs & building system" "$TMP_LOG"
wait "$CMD_PID"
exit_code=$?

cat "$TMP_LOG"
rm -f "$TMP_LOG"

if [ $exit_code -eq 0 ]; then
  fastfetch-update-cache 2>/dev/null || true
  echo -e "${GREEN}✔ System update completed successfully!${RESET}"
else
  echo -e "${RED}✖ Update failed with exit code $exit_code${RESET}"
  exit $exit_code
fi
