# Titan X — single NVIDIA dGPU (PCI:9:0:0).
{ config, pkgs, lib, ... }:

let
  appGpuEnv = {
    LIBVA_DRIVER_NAME = "nvidia";
    __GLX_VENDOR_LIBRARY_NAME = "nvidia";
    __GL_GSYNC_ALLOWED = "1";
    __GL_MaxFramesAllowed = "1";
    __GL_SHADER_DISK_CACHE = "1";
    __GL_SHADER_DISK_CACHE_SKIP_CLEANUP = "1";
    DXVK_ASYNC = "1";
    NVD_BACKEND = "direct";
  };

  hyprGpuEnv = appGpuEnv // {
    GBM_BACKEND = "nvidia-drm";
  };

  appGpuEnvNames = lib.attrNames appGpuEnv;

  hyprLuaLines = lib.concatStringsSep "\n" (
    lib.mapAttrsToList (n: v: ''hl.env("${n}", "${v}")'') hyprGpuEnv
  );
in
{
  home.sessionVariables = appGpuEnv;

  xdg.configFile."hypr/gpu-env.lua" = {
    text = ''
      -- Generated by home/hosts/cleboost-brain/gpu.nix
      ${hyprLuaLines}
    '';
  };

  home.file.".local/bin/gpu-import-env" = {
    executable = true;
    text = ''
      #!${pkgs.bash}/bin/bash
      systemctl --user import-environment ${lib.concatStringsSep " " appGpuEnvNames}
    '';
  };
}
