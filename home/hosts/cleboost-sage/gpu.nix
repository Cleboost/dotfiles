# PRIME — AMD iGPU primary, NVIDIA dGPU fallback.
{ pkgs, lib, ... }:

let
  hyprGpuEnv = {
    AQ_DRM_DEVICES = "/dev/dri/card1:/dev/dri/card0";
    WLR_DRM_DEVICES = "/dev/dri/card1:/dev/dri/card0";
  };

  hyprLuaLines = lib.concatStringsSep "\n" (
    lib.mapAttrsToList (n: v: ''hl.env("${n}", "${v}")'') hyprGpuEnv
  );
in
{
  xdg.configFile."hypr/gpu-env.lua" = {
    text = ''
      -- Generated by home/hosts/cleboost-sage/gpu.nix
      ${hyprLuaLines}
    '';
  };

  home.file.".local/bin/gpu-import-env" = {
    executable = true;
    text = ''
      #!${pkgs.bash}/bin/bash
      true
    '';
  };
}
