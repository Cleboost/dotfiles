# PRIME — Hyprland on the AMD iGPU only, so the NVIDIA dGPU can sleep.
# /run/dri/amd-card has no ':' — Aquamarine splits AQ_DRM_DEVICES on colons,
# and pci-0000:06:00.0-card made Hyprland abort with "Found no gpus".
{ pkgs, lib, ... }:

let
  amdCard = "/run/dri/amd-card";

  hyprGpuEnv = {
    AQ_DRM_DEVICES = amdCard;
    WLR_DRM_DEVICES = amdCard;
  };

  hyprLuaLines = lib.concatStringsSep "\n" (
    lib.mapAttrsToList (n: v: ''hl.env("${n}", "${v}")'') hyprGpuEnv
  );
in
{
  home.sessionVariables = hyprGpuEnv;

  xdg.configFile."hypr/gpu-env.lua" = {
    text = ''
      -- Generated by home/hosts/cleboost-sage/gpu.nix
      ${hyprLuaLines}
    '';
  };

  home.file.".local/bin/gpu-import-env" = {
    executable = true;
    text = ''
      #!${pkgs.bash}/bin/bash
      true
    '';
  };
}
